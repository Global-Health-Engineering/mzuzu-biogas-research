

// DO NOT FORGET TO REMOVE SB9 JUMPER ON THE NUCLEO BOARD

/* SX1276 LoRa module connected to Nucleo-L432KC over SPI1 */
&spi1 {
    status = "okay";
    cs-gpios = <&gpiob 1 GPIO_ACTIVE_LOW>; 
    pinctrl-0 = < &spi1_sck_pa1 &spi1_miso_pa11 &spi1_mosi_pa7 >;
    lora0: sx1276@0 {
        compatible = "semtech,sx1276";
        reg = <0>;
        label = "SX1276";
        spi-max-frequency = <DT_FREQ_M(8)>;
        status = "okay";
        reset-gpios = <&gpioa 8 GPIO_ACTIVE_LOW>;  
        dio-gpios = <&gpiob 6 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>,
                    <&gpiob 4 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>,
                    <&gpioa 5 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
        power-amplifier-output = "pa-boost";
        //dio3-tcxo-voltage = <SX126X_DIO3_TCXO_1V8>;
    };
};


&usart1_tx_pa9 {
	drive-open-drain;
	bias-pull-up;
    slew-rate = "very-high-speed";
};

&can1 {
    status = "disabled";
};

&i2c1 {
    status = "disabled";
};


&lptim1 {
    status = "okay";
};


&usart1 {
    status = "okay";
    single-wire;
    current-speed = <115200>;
    w1_0: w1-zephyr-serial-0 {
		compatible = "zephyr,w1-serial";
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		ds18b20-0 {
            label = "SENSOR_DS18B20_0";
            compatible = "maxim,ds18b20";
            family-code = <0x28>;
            resolution = <12>;
            status = "okay";
        };
        
        
        ds18b20-1 {
            label = "SENSOR_DS18B20_1";
            compatible = "maxim,ds18b20";
            family-code = <0x28>;
            resolution = <12>;
            status = "okay";
        };

        ds18b20-2 {
            label = "SENSOR_DS18B20_2";
            compatible = "maxim,ds18b20";
            family-code = <0x28>;
            resolution = <12>;
            status = "okay";
        };
       
        
        // already having two nodes in the device tree is enough
        // to start identifying multiple devices on the bus 
        // with their ROMs
	};
};

&rtc {
    status = "disabled";
    //clocks = <&rcc STM32_CLOCK(APB1, 10U)>;
    //wakeup-source;
};

&timers6{
    status = "disabled";
};

&timers2{
    status = "okay";
    st,prescaler = <7999>;// will count with ticks of 0.1ms
    counter2: counter{
        compatible = "st,stm32-counter";
        status = "okay";
    };
};

&timers15{
    st,prescaler = <79>;
    status = "okay";
    pwm15: pwm{
        compatible = "st,stm32-pwm";
        status = "okay";
        pinctrl-0 = <&tim15_ch2_pa3>;
        pinctrl-names = "default";
    };
};

&die_temp{
    status = "okay";
};

&adc1{
    status = "okay";
    st,adc-clock-source = "SYNC";
    st,adc-prescaler = < 4 >;
    #address-cells = <1>;
	#size-cells = <0>;
    vref-mv = <3300>;
    channel@b{
        reg = <11>;
        zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
    };
};

&vref {
    status = "okay";
};

/ {
    pwmleds: pwmleds{
        compatible = "pwm-leds";
        status = "okay";
        pwmvalve: tim15_ch2n_pwm{
            pwms = <&pwm15 2 PWM_MSEC(2) PWM_POLARITY_NORMAL>;
        };
    };
    aliases {
        lora0 = &lora0;
        rtc0 = &rtc;
        lora-en-pin = &lora_en;
        lora-reset-pin = &lore_reset;
        led-green-pin = &led_green;
        led-red-pin = &led_red;
        die-temp0 = &die_temp;
    };

    chosen{
        zephyr,rtc = &rtc;

        //zephyr,cortex-m-idle-timer = &rtc;
    };

    zephyr,user{
        io-channels = <&adc1 11>;
    };

    leds{
        compatible = "gpio-leds";
        status = "okay";

        lora_en: lora-en{
            gpios = <&gpiob 7 GPIO_ACTIVE_HIGH>;
            label = "LORA_ENABLE";
        };

        led_green: led-green{
            gpios = <&gpioa 5 GPIO_ACTIVE_HIGH>;
            label = "LED_GREEN";
        };

        led_red: led-red{
            gpios = <&gpioa 4 GPIO_ACTIVE_HIGH>;
            label = "LED_RED";
        };

        lore_reset: lora-reset{
            gpios = <&gpioa 8 GPIO_ACTIVE_LOW>;
            label = "LORA_RESET";
        };
    };

};

